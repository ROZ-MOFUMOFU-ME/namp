{
    "name": "namp",
    "version": "1.0.0",
    "description": "NAMP - Node All-in-One Mining Portal",
    "private": true,
    "type": "module",
    "license": "(MIT AND GPL-2.0-only)",
    "author": "ROZ-MOFUMOFU-ME",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ROZ-MOFUMOFU-ME/namp.git"
    },
    "workspaces": [
        "packages/*",
        "packages/portal/web"
    ],
    "engines": {
        "node": ">=22.18.0",
        "npm": ">=9"
    },
    "scripts": {
        "typecheck": "npm run typecheck --workspaces --if-present",
        "test": "node --test test/*.test.cjs && npm test --workspace stratum-pool && npm run test:unit --workspace namp-portal",
        "lint": "eslint packages/portal/src/init.ts packages/stratum-pool/src packages/stratum-pool/test packages/portal/web/src",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint:fix": "eslint packages/portal/src/init.ts packages/stratum-pool/src packages/stratum-pool/test packages/portal/web/src --fix",
        "check:config": "npm run check:config --workspace namp-portal",
        "web:dev": "npm run dev --workspace namp-web",
        "build": "npm run build --workspace namp-web",
        "install": "node-gyp rebuild",
        "rebuild:native": "node-gyp rebuild"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/eslint-parser": "^8.0.1",
        "@babel/plugin-syntax-jsx": "^8.0.1",
        "@babel/preset-typescript": "^8.0.1",
        "@eslint/js": "^10.0.1",
        "@types/async": "^3.2.25",
        "@types/compression": "^1.8.1",
        "@types/dateformat": "^5.0.3",
        "@types/express": "^5.0.6",
        "@types/extend": "^3.0.4",
        "@types/node": "^26.1.2",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.6",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    },
    "dependencies": {
        "bindings": "^1.5.0",
        "nan": "^2.28.0"
    },
    "gypfile": true
}
