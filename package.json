{
    "name": "namp",
    "version": "1.0.0",
    "description": "NAMP - Node All-in-One Mining Portal",
    "private": true,
    "type": "module",
    "license": "(MIT AND GPL-2.0-only)",
    "author": "ROZ-MOFUMOFU-ME",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ROZ-MOFUMOFU-ME/namp.git"
    },
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": ">=22.18.0",
        "npm": ">=9"
    },
    "scripts": {
        "typecheck": "npm run typecheck --workspaces --if-present",
        "test": "npm test --workspace multi-hashing --workspace stratum-pool && npm run test:unit --workspace namp-portal",
        "lint": "npm run lint --workspaces --if-present",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@babel/eslint-parser": "^8.0.1",
        "@babel/preset-typescript": "^8.0.1",
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.9.3",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.8.4",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "esbuild@0.28.1": true,
        "multi-hashing@1.2.0": true
    }
}
