{
    "name": "namp",
    "version": "1.0.0",
    "description": "NAMP - Node All-in-One Mining Portal",
    "private": true,
    "type": "module",
    "license": "(MIT AND GPL-2.0-only)",
    "author": "ROZ-MOFUMOFU-ME",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ROZ-MOFUMOFU-ME/namp.git"
    },
    "workspaces": [
        "web"
    ],
    "engines": {
        "node": ">=22.18.0",
        "npm": ">=9"
    },
    "scripts": {
        "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
        "test": "node --test test/*.test.cjs test/*.test.ts",
        "lint": "eslint src/init.ts src/stratum test web/src",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint:fix": "eslint src/init.ts src/stratum test web/src --fix",
        "check:config": "node --test test/config.test.ts",
        "web:dev": "npm run dev --workspace namp-web",
        "build": "npm run build --workspace namp-web",
        "install": "node-gyp rebuild",
        "rebuild:native": "node-gyp rebuild",
        "start": "node --import tsx src/init.ts"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/eslint-parser": "^8.0.1",
        "@babel/plugin-syntax-jsx": "^8.0.1",
        "@babel/preset-typescript": "^8.0.1",
        "@eslint/js": "^10.0.1",
        "@types/async": "^3.2.25",
        "@types/compression": "^1.8.1",
        "@types/dateformat": "^5.0.3",
        "@types/express": "^5.0.6",
        "@types/extend": "^3.0.4",
        "@types/node": "^26.1.2",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.6",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    },
    "dependencies": {
        "@exodus/bitcoinjs-lib-zcash": "^0.0.21",
        "async": "^3.2.6",
        "bindings": "^1.5.0",
        "bitcoinjs-lib": "^7.0.1",
        "colors": "^1.4.0",
        "compression": "^1.8.1",
        "dateformat": "^5.0.3",
        "express": "^5.2.1",
        "extend": "^3.0.2",
        "nan": "^2.28.0",
        "node-json-minify": "^3.0.0",
        "node-watch": "^0.7.4",
        "redis": "^6.2.0",
        "tsx": "^4.23.1"
    },
    "gypfile": true,
    "overrides": {
        "flatted": "^3.4.2"
    }
}
